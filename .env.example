# TEIA Tutor AI Service - Environment Configuration
# Copy this file to .env and adjust values as needed

# === Ollama Configuration ===
OLLAMA_URL=http://localhost:11434
# Recommended models for Spanish educational content:
#   qwen2.5:7b-instruct  - Best Spanish quality (4.2GB)
#   mistral:7b-instruct  - Fastest, smallest (3.8GB)
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=mistral:7b-instruct
OLLAMA_TIMEOUT=120

# === CORS Configuration ===
# Comma-separated list of allowed origins (Angular frontend, Java API, etc.)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8080

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FILE=logs/teia_tutor.log
ENABLE_JSON_LOGS=false
